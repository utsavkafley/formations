# Copy to .env.local (or .env) and fill in REAL values from your Supabase
# project → Project Settings → API. Both files are git-ignored.
#
# IMPORTANT: replace the whole URL — "your-project" below is a placeholder.
# If these are left as placeholders the app can't reach Supabase and nothing
# saves (it does NOT fall back to local mode once the vars are non-empty).
#
# Leave BOTH blank to run in local-only mode (localStorage, single device).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for the Supabase CLI (db push / functions deploy) — the frontend
# never reads this. Keep it secret; it's git-ignored via .env.
# SUPABASE_DB_PASSWORD=your-db-password
